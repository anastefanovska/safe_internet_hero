rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isModerator() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true;
    }

    // Users: any authenticated user can read (friend search, leaderboard).
    // Owners may write their own doc, but can NEVER grant themselves the
    // isAdmin/isModerator role and may only move moderatorStatus between
    // 'none' and 'pending' (requesting/withdrawing). Roles and an 'approved'
    // status are admin-only. Admins may write anything.
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId)
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('isModerator', false) == false;
      // Owners may write their own doc but can never change isAdmin/isModerator,
      // and may only move moderatorStatus to 'none'/'pending' (or leave it
      // unchanged). `.get(..., default)` keeps legacy docs that predate these
      // fields working for ordinary self-writes (stars, streak, reads, etc.).
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.get('isAdmin', false)
             == resource.data.get('isAdmin', false)
        && request.resource.data.get('isModerator', false)
             == resource.data.get('isModerator', false)
        && (
          request.resource.data.get('moderatorStatus', 'none')
              == resource.data.get('moderatorStatus', 'none')
          || request.resource.data.get('moderatorStatus', 'none') in ['none', 'pending']
        )
      );
      allow delete: if isAdmin();
    }

    // Moderator applications: doc id == the applicant's uid.
    // The user may only ever write a 'pending' request (never self-approve);
    // admins approve/reject/revoke.
    match /moderator_requests/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // In-app notifications: owner reads/dismisses; only admins create them.
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAdmin();
      allow update, delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // Public content (questions, categories, topics, learning_content):
    // readable by anyone (guests play without an account),
    // writable only by admins
    // Questions are world-readable (guests play). Admins write freely.
    // Moderators may ONLY create questions that are pending and authored by
    // themselves. They may also revise & resubmit a question they authored, but
    // the result must stay authored by them and re-enter review as 'pending' —
    // so a moderator can never self-approve, take over someone else's question,
    // or delete. Admins approve/reject/request-changes.
    match /questions/{questionId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isModerator()
        && request.resource.data.status == 'pending'
        && request.resource.data.authorId == request.auth.uid
      );
      allow update: if isAdmin() || (
        isModerator()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'pending'
      );
      // Moderators may delete their OWN submissions to declutter, but never an
      // approved (live) question — that stays admin-only.
      allow delete: if isAdmin() || (
        isModerator()
        && resource.data.authorId == request.auth.uid
        && resource.data.status != 'approved'
      );
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /learning_content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Quiz results: users create/read their own; admins read all
    match /quiz_results/{resultId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Daily challenges: one progress doc per user per day
    // (id == `${uid}_${yyyy-MM-dd}`). Owners read/write only their own; the
    // reward is granted by the owner incrementing coins on their own user doc.
    // The read allows a missing doc (resource == null) — the card listens to
    // today's doc before it's ever created, and a null resource carries no data.
    match /daily_challenges/{docId} {
      allow read: if isAuth() && (resource == null || isOwner(resource.data.userId));
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin();
    }

    // Mini-game plays: one marker doc per user per game per day
    // (id == `${uid}_${gameId}_${yyyy-MM-dd}`), used to grant a mini-game's
    // coins at most once a day. Owners read/create only their own; the reward is
    // the owner incrementing coins on their own user doc in the same write.
    // Immutable once created (no update) so the daily coin can't be re-claimed.
    match /mini_game_plays/{docId} {
      allow read: if isAuth() && (resource == null || isOwner(resource.data.userId));
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Activities: authenticated users can read any (friend feed),
    //             users can only create activities for themselves
    match /activities/{activityId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
